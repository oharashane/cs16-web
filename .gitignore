node_modules/
client/node_modules/
client/dist/

# Python
__pycache__/
*.pyc

# Docker env files (but allow .env.example template)
.env
.env.local
.env.production
.env.development
.env.staging

# Large binary files and game assets
**/addons/**/logs/
**/addons/**/dlls/*.so
**/addons/**/modules/*.so

# Build runtime directories (not the compiled game engine files)
**/rwdir/

# Exclude binaries EXCEPT essential client game engine files
**/*.so
!**/client/assets/*.so
**/*.wasm
!**/client/assets/*.wasm

# Backup files
**/*.backup
**/*.bak

# Copyrighted game content (user must provide their own)
**/valve.zip
**/valve/
**/cstrike/
# But allow templates and scripts
!**/valve.template/
!**/cstrike.template/
!**/*-template.*

# Go build artifacts
**/go-webrtc-server/cs16-webrtc-relay
**/go-webrtc-server/webrtc-server
**/go-webrtc-server/**/main
**/go-webrtc-server/**/*-relay
**/go-webrtc-server/server

# Python build artifacts
**/__pycache__/
**/*.pyc
**/*.pyo

# Editors
.vscode/
.idea/
.DS_Store


**/client-backup*/

**/valve.zip
*.ztmp
**/valve.zip.backup*
**/*valve.zip
**/*valve.zip.backup*
**/*valve*.zip
**/valve.zip.*

cs-server/logs

cs-server/shared/maps/
cs-server/shared/overviews/
cs-server/shared/models/
cs-server/shared/sprites/
cs-server/shared/wads/
cs-server/shared/*.wad
cs-server/shared/sound/
cs-server/shared/gfx/
cs-server/shared/events/
cs-server/shared/resource/
cs-server/shared/logos/
cs-server/shared/media/
cs-server/shared/hw/

cs-server/**/amxmodx/data/lang/
cs-server/**/addons/amxmodx/plugins/
cs-server/**/addons/amxmodx/scripting/



# The relay binary the unit builds, and the file with its admin key
web-server/go-webrtc-server/relay
.relay.env

# engine/: built artefacts and the wrapper's generated glue; the recipes are tracked
engine/*/dist/
engine/*/node_modules/
engine/*/build.log
engine/xash3d-fwgs/lib/generated/xash.js

# the page built on our own engine, served at /next
web/dist-next/

# cs-server/navs: the bots' meshes are kept, the links to the content are not
cs-server/navs/*
!cs-server/navs/*.nav
!cs-server/navs/README.md

# The server's admin list, written by the relay from its people file
cs-server/main/addons/amxmodx/configs/users.ini
.relay-people.json

# The game in bundles: content itself is never committed; the manifest is
content/base.zip
content/maps/
