+/*
+=================
+CL_DemoReadMessageGoldSrc
+
+walks GoldSrc frames until a network message is due; the client-side frames on the way
+are handed to the engine
+=================
+*/
+static qboolean CL_DemoReadMessageGoldSrc( byte *buffer, size_t *length )
+{
+	*length = 0;
+
+	if( !cls.demofile )
+	{
+		CL_DemoCompleted();
+		return false;
+	}
+
+	if(( !cl.background && ( cl.paused || cls.key_dest != key_game )) || cls.key_dest == key_console )
+	{
+		if( demo.gs_traced < 48 && host_developer.value >= DEV_NORMAL )
+		{
+			Con_Printf( "GoldSrc demo: waiting (paused %i, key_dest %i, background %i)\n", cl.paused, cls.key_dest, cl.background );
+			demo.gs_traced++;
+		}
+		demo.starttime += host.frametime;
+		return false; // paused
+	}
+
+	for( ;; )
+	{
+		hldemo_frame_t	frame;
+		size_t		curpos = FS_Tell( cls.demofile );
+		float		elapsed;
+
+		if( FS_Read( cls.demofile, &frame, sizeof( frame )) != sizeof( frame ))
+		{
+			// a recording cut short has no closing frame
+			Con_Printf( "GoldSrc demo: end of file after %i frames\n", demo.framecount );
+			CL_DemoCompleted();
+			return false;
+		}
+
+		if( demo.gs_traced < 48 && host_developer.value >= DEV_NORMAL )
+		{
+			Con_Printf( "GoldSrc demo: section %i frame %i type %i time %.2f\n", demo.entryIndex, frame.frame, frame.type, frame.time );
+			demo.gs_traced++;
+		}
+
+		if( frame.type > hldemo_lastcmd )
+			return CL_HLDemoBroken( "unknown frame type" );
+
+		// GoldSrc stamps frames with the game clock; ours count from the section's first
+		if( !demo.gs_section_open && frame.type <= hldemo_netmsg )
+		{
+			demo.gs_section_time = frame.time;
+			demo.gs_section_open = true;
+		}
+		demo.timestamp = demo.gs_section_open ? frame.time - demo.gs_section_time : 0.0f;
+
+		if( cls.changelevel ) demo.framecount = 1;
+
+		// a section's clock starts with its first messages, as CL_DemoReadMessage does it
+		elapsed = CL_GetDemoPlaybackClock() - demo.starttime;
+		if( demo.framecount <= 2 && ( elapsed - demo.timestamp ) > host.frametime )
+		{
+			demo.starttime = CL_GetDemoPlaybackClock();
+			elapsed = CL_GetDemoPlaybackClock() - demo.starttime;
+		}
+
+		// not time for this message yet: put it back
+		if( frame.type == hldemo_netmsg && !cls.timedemo && demo.framecount != 0
+			&& ( demo.timestamp - cl_serverframetime( )) >= elapsed )
+		{
+			FS_Seek( cls.demofile, curpos, SEEK_SET );
+			return false;
+		}
+
+		switch( frame.type )
+		{
+		case hldemo_netmsg_start:
+		case hldemo_netmsg:
+			return CL_ReadHLDemoNetMsg( buffer, length );
+		case hldemo_demostart:
+			break;
+		case hldemo_consolecommand:
+			{
+				char	cmd[64];
+
+				if( FS_Read( cls.demofile, cmd, sizeof( cmd )) != sizeof( cmd ))
+					return CL_HLDemoBroken( "truncated frame" );
+				cmd[sizeof( cmd ) - 1] = 0;
+
+				// what the player typed while recording; the buttons ride in the usercmd,
+				// and nothing else has been worth replaying yet
+				Con_Reportf( "GoldSrc demo: command \"%s\" not replayed\n", cmd );
+			}
+			break;
+		case hldemo_clientdata:
+			FS_Seek( cls.demofile, 32, SEEK_CUR ); // svc_clientdata carries the same
+			break;
+		case hldemo_nextsection:
+			demo.gs_section_open = false;
+			demo.gs_traced = 0;
+			if( host_developer.value >= DEV_NORMAL )
+				Con_Printf( "GoldSrc demo: section %i done after %i frames\n", demo.entryIndex, demo.framecount );
+			CL_DemoMoveToNextSection();
+			return false;
+		case hldemo_event:
+			{
+				hldemo_event_t	ev;
+
+				if( FS_Read( cls.demofile, &ev, sizeof( ev )) != sizeof( ev ))
+					return CL_HLDemoBroken( "truncated frame" );
+				CL_QueueEvent( ev.flags, ev.index, ev.delay, &ev.args );
+			}
+			break;
+		case hldemo_weaponanim:
+			{
+				int	anim[2];
+
+				if( FS_Read( cls.demofile, anim, sizeof( anim )) != sizeof( anim ))
+					return CL_HLDemoBroken( "truncated frame" );
+				CL_WeaponAnim( anim[0], anim[1] );
+			}
+			break;
+		case hldemo_sound:
+			{
+				char	name[256];
+				int	channel, len, flags, pitch;
+				float	attn, vol;
+
+				if( FS_Read( cls.demofile, &channel, sizeof( int )) != sizeof( int )
+					|| FS_Read( cls.demofile, &len, sizeof( int )) != sizeof( int ))
+					return CL_HLDemoBroken( "truncated frame" );
+				if( len < 0 || len >= sizeof( name ))
+					return CL_HLDemoBroken( "bad sound name length" );
+				if( FS_Read( cls.demofile, name, len ) != len )
+					return CL_HLDemoBroken( "truncated frame" );
+				name[len] = 0;
+				if( FS_Read( cls.demofile, &attn, sizeof( float )) != sizeof( float )
+					|| FS_Read( cls.demofile, &vol, sizeof( float )) != sizeof( float )
+					|| FS_Read( cls.demofile, &flags, sizeof( int )) != sizeof( int )
+					|| FS_Read( cls.demofile, &pitch, sizeof( int )) != sizeof( int ))
+					return CL_HLDemoBroken( "truncated frame" );
+
+				// the client dll played it for the recording player
+				S_StartSound( NULL, cl.playernum + 1, channel, S_RegisterSound( name ), vol, attn, pitch, flags );
+			}
+			break;
+		case hldemo_demobuffer:
+			{
+				byte	*buf;
+				int	size;
+
+				if( FS_Read( cls.demofile, &size, sizeof( int )) != sizeof( int ))
+					return CL_HLDemoBroken( "truncated frame" );
+				if( size < 0 || size > MAX_INIT_MSG )
+					return CL_HLDemoBroken( "bad buffer length" );
+				buf = Mem_Malloc( cls.mempool, size + 1 );
+				if( FS_Read( cls.demofile, buf, size ) != size )
+				{
+					Mem_Free( buf );
+					return CL_HLDemoBroken( "truncated frame" );
+				}
+				if( clgame.hInstance )
+					clgame.dllFuncs.pfnDemo_ReadBuffer( size, buf );
+				Mem_Free( buf );
+			}
+			break;
+		}
+	}
+}
