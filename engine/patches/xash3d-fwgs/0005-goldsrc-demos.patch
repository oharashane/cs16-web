+/*
+===============================================================================
+
+GOLDSRC DEMOS
+
+A GoldSrc demo (magic "HLDEMO") is what Half-Life and Counter-Strike have recorded since
+1998: a header, a directory of sections, and frames. Its network-message frame is the
+same seven netchan sequence numbers and the same stripped server message as our dem_read
+frame, behind 436 bytes of the client's own state. Its client-side frames — events,
+weapon animations, sounds, the client dll's buffer — have no frame of ours, because we
+re-run the recorded usercmds through prediction instead; they are handed to the engine
+calls that produced them. Layouts as in hlviewer.js, hldemo-rs and compLexity Demo
+Player, checked against files from 2004 (protocol 47) and 2022 (protocol 48).
+
+===============================================================================
+*/
+#define HLDEMO_IDENT		(('E'<<24)+('D'<<16)+('L'<<8)+'H') // little-endian "HLDE"
+#define HLDEMO_PROTOCOL		5
+#define HLDEMO_NET_PROTOCOL_MIN	46	// Half-Life 1.1.0.x, before Steam
+#define HLDEMO_MAX_ENTRIES	1024
+#define HLDEMO_INFO_SIZE		436	// float timestamp, ref_params_t, usercmd_t, movevars_t, view, viewmodel
+#define HLDEMO_INFO_VIEWANGLES	16	// ref_params_t.viewangles: after the timestamp and vieworg
+#define HLDEMO_INFO_USERCMD	236	// usercmd_t: after the timestamp and ref_params_t
+
+enum
+{
+	hldemo_netmsg_start = 0,	// a network message of the loading section
+	hldemo_netmsg,		// a network message
+	hldemo_demostart,
+	hldemo_consolecommand,	// char[64]
+	hldemo_clientdata,		// origin, angles, weapon bits, fov: 32 bytes
+	hldemo_nextsection,
+	hldemo_event,		// hldemo_event_t
+	hldemo_weaponanim,		// int sequence, int body
+	hldemo_sound,		// int channel, int length, name, float attenuation, float volume, int flags, int pitch
+	hldemo_demobuffer,		// int length, bytes for the client dll
+	hldemo_lastcmd = hldemo_demobuffer
+};
+
+#pragma pack( push, 1 )
+typedef struct
+{
+	char		magic[8];		// "HLDEMO\0\0"
+	int		demo_protocol;	// HLDEMO_PROTOCOL
+	int		net_protocol;	// 46, 47 or 48
+	char		mapname[260];
+	char		gamedir[260];
+	uint32_t		map_crc;
+	int		directory_offset;
+} hldemo_header_t;
+
+typedef struct
