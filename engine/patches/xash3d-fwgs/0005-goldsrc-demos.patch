+/*
+=================
+CL_ReadHLDemoNetMsg
+
+a network-message frame: the client's state, of which the usercmd and the view angles
+are kept, then exactly what a dem_read frame holds
+=================
+*/
+static qboolean CL_ReadHLDemoNetMsg( byte *buffer, size_t *length )
+{
+	byte		info[HLDEMO_INFO_SIZE];
+	runcmd_t		*pcmd;
+	demoangle_t	*a;
+	vec3_t		viewangles;
+	int		msglen;
+
+	if( FS_Read( cls.demofile, info, sizeof( info )) != sizeof( info ))
+		return CL_HLDemoBroken( "truncated frame" );
+
+	CL_ReadDemoSequence( false );
+
+	if( FS_Read( cls.demofile, &msglen, sizeof( msglen )) != sizeof( msglen ))
+		return CL_HLDemoBroken( "truncated frame" );
+
+	if( msglen < 0 || msglen > MAX_INIT_MSG )
+		return CL_HLDemoBroken( "bad message length" );
+
+	// the usercmd the client ran at this frame, where CL_ReadDemoUserCmd puts a decoded one
+	pcmd = &cl.commands[( cls.netchan.outgoing_sequence + 1 ) & CL_UPDATE_MASK];
+	pcmd->processedfuncs = false;
+	pcmd->senttime = 0.0f;
+	pcmd->receivedtime = 0.1f;
+	pcmd->frame_lerp = 0.1f;
+	pcmd->heldback = false;
+	pcmd->sendsize = 1;
+	memcpy( &pcmd->cmd, info + HLDEMO_INFO_USERCMD, sizeof( pcmd->cmd ));
+	cl.cmd = pcmd->cmd;
+
+	// the view angles, into the ring CL_DemoInterpolateAngles reads
+	memcpy( viewangles, info + HLDEMO_INFO_VIEWANGLES, sizeof( viewangles ));
+	if( demo.lasttime != demo.timestamp )
+	{
+		demo.angle_position = ( demo.angle_position + 1 ) & ANGLE_MASK;
+		a = &demo.cmds[demo.angle_position];
+		a->starttime = demo.timestamp;
+		VectorCopy( viewangles, a->viewangles );
+		demo.lasttime = demo.timestamp;
+	}
+
+	if( msglen > 0 && FS_Read( cls.demofile, buffer, msglen ) != msglen )
+		return CL_HLDemoBroken( "truncated message" );
+
+	demo.framecount++;
+	cls.netchan.last_received = host.realtime;
+	cls.netchan.total_received += msglen;
+	*length = msglen;
+
+	if( cls.state != ca_active )
+		Cbuf_Execute();
+
+	return true;
+}
