+	char		description[64];
+	int		flags;
+	int		cdtrack;
+	float		track_time;
+	int		frame_count;
+	int		offset;
+	int		length;
+} hldemo_entry_t;
+
+typedef struct
+{
+	byte		type;
+	float		time;		// the game clock, not a section offset
+	int		frame;
+} hldemo_frame_t;
+
+typedef struct
+{
+	int		flags;
+	int		index;
+	float		delay;
+	event_args_t	args;
+} hldemo_event_t;
