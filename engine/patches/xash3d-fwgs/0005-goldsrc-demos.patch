+/*
+=================
+CL_ParseHLDemoHeader
+
+the header and directory of a GoldSrc demo, into our own header and entries
+=================
+*/
+static qboolean CL_ParseHLDemoHeader( const char *callee, const char *filename, file_t *f )
+{
+	hldemo_header_t	hdr;
+	hldemo_entry_t	entry;
+	int32_t		numentries, i;
+
+	if( FS_Read( f, &hdr, sizeof( hdr )) != sizeof( hdr ) || memcmp( hdr.magic, "HLDEMO", 6 ))
+	{
+		Con_Printf( S_ERROR "%s: %s is not a GoldSrc demo\n", callee, filename );
+		return false;
+	}
+
+	if( hdr.demo_protocol != HLDEMO_PROTOCOL )
+	{
+		Con_Printf( S_ERROR "%s: GoldSrc demo protocol %i, only %i is known\n", callee, hdr.demo_protocol, HLDEMO_PROTOCOL );
+		return false;
+	}
+
+	if( hdr.net_protocol < HLDEMO_NET_PROTOCOL_MIN || hdr.net_protocol > PROTOCOL_GOLDSRC_VERSION )
+	{
+		Con_Printf( S_ERROR "%s: GoldSrc net protocol %i, only %i to %i are known\n",
+			callee, hdr.net_protocol, HLDEMO_NET_PROTOCOL_MIN, PROTOCOL_GOLDSRC_VERSION );
+		return false;
+	}
+
+	if( FS_Seek( f, hdr.directory_offset, SEEK_SET ) < 0
+		|| FS_Read( f, &numentries, sizeof( numentries )) != sizeof( numentries ))
+	{
+		Con_Printf( S_ERROR "%s: can't find directory offset in %s, demo file corrupted\n", callee, filename );
+		return false;
+	}
+
+	if( numentries < 1 || numentries > HLDEMO_MAX_ENTRIES )
+	{
+		Con_Printf( S_ERROR "%s: demo have bogus # of directory entries: %i\n", callee, numentries );
+		return false;
+	}
+
+	hdr.mapname[sizeof( hdr.mapname ) - 1] = 0;
+	hdr.gamedir[sizeof( hdr.gamedir ) - 1] = 0;
+
+	memset( &demo.header, 0, sizeof( demo.header ));
+	demo.header.id = IDEMOHEADER;
+	demo.header.dem_protocol = DEMO_PROTOCOL;
+	demo.header.net_protocol = PROTOCOL_GOLDSRC_VERSION_DEMO;
+	demo.header.host_fps = host_maxfps.value;
+	demo.header.directory_offset = hdr.directory_offset;
+	Q_strncpy( demo.header.mapname, hdr.mapname, sizeof( demo.header.mapname ));
+	Q_strncpy( demo.header.gamedir, hdr.gamedir, sizeof( demo.header.gamedir ));
+	Q_snprintf( demo.header.comment, sizeof( demo.header.comment ), "GoldSrc demo, protocol %i", hdr.net_protocol );
+
+	demo.directory.numentries = numentries;
+	demo.directory.entries = Mem_Malloc( cls.mempool, sizeof( *demo.directory.entries ) * numentries );
+
+	for( i = 0; i < numentries; i++ )
+	{
+		demoentry_t	*e = &demo.directory.entries[i];
+
+		if( FS_Read( f, &entry, sizeof( entry )) != sizeof( entry ))
+		{
+			Con_Printf( S_ERROR "%s: demo entry %i of %s corrupted\n", callee, i, filename );
+			Mem_Free( demo.directory.entries );
+			demo.directory.entries = NULL;
+			demo.directory.numentries = 0;
+			return false;
+		}
+
+		entry.description[sizeof( entry.description ) - 1] = 0;
+		e->entrytype = entry.entrytype;
+		e->playback_time = entry.track_time;
+		e->playback_frames = entry.frame_count;
+		e->offset = entry.offset;
+		e->length = entry.length;
+		e->flags = entry.flags;
+		Q_strncpy( e->description, entry.description, sizeof( e->description ));
+	}
+
+	demo.gs_protocol = hdr.net_protocol;
+	demo.gs_section_open = false;
+	demo.gs_traced = 0;
+
+	Con_Printf( "GoldSrc demo: protocol %i, map %s, game %s, %i sections\n",
+		hdr.net_protocol, hdr.mapname, hdr.gamedir, numentries );
+
+	return true;
+}
