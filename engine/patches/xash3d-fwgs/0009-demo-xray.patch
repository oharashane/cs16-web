+// The museum's wallhack, for recordings only. The OpenGL wallhacks of 2000-2004 were a
+// wrapper opengl32.dll that turned the depth test off when a player model drew; the
+// later "chams" drew the hidden part of a player flat and bright. This does the second,
+// which is the first made visible: after the normal draw, a player is drawn again with the
+// depth test reversed (only where a wall won), no texture and one bright colour, so what
+// is behind the wall shows as a bright shape and what is in plain sight is untouched. It
+// shows exactly what those cheats showed — the players the server sent, the potentially
+// visible set, and no more — and does nothing outside a recording: PARM_PLAYING_DEMO is
+// the gate, not the cvar. It sits in R_StudioDrawPoints because that is where every path
+// draws: the Counter-Strike client has a studio renderer of its own and calls back in
+// here to emit the triangles.
+CVAR_DEFINE_AUTO( r_demo_xray, "0", 0, "draw players through walls while a recording plays" );
+static qboolean g_xrayPass;
+static void R_StudioDrawPointsPass( void );
+
+static void R_StudioDrawPoints( void )
+{
+	if( r_demo_xray.value != 0.0f && RI.currententity && RI.currententity->player && ENGINE_GET_PARM( PARM_PLAYING_DEMO ) != DEMO_INACTIVE )
+	{
+		// first, so that the test is against the world and not against the player's own
+		// nearer parts; the normal draw then covers whatever is in plain sight
+		g_xrayPass = true;
+		pglDepthFunc( GL_GREATER );
+		pglDepthMask( GL_FALSE );
+		pglDisable( GL_TEXTURE_2D );
+		R_StudioDrawPointsPass();
+		pglEnable( GL_TEXTURE_2D );
+		pglDepthMask( GL_TRUE );
+		pglDepthFunc( GL_LEQUAL );
+		g_xrayPass = false;
+	}
+
+	R_StudioDrawPointsPass();
+}
