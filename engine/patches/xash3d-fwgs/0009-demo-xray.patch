 // studio-related cvars
 CVAR_DEFINE_AUTO( r_studio_sort_textures, "0", FCVAR_GLCONFIG, "change draw order for additive meshes" );
 CVAR_DEFINE_AUTO( r_studio_drawelements, "1", FCVAR_GLCONFIG, "use glDrawElements for studiomodels" );
+// The museum's wallhack, for recordings only. The OpenGL wallhacks of 2000-2004 were a
+// wrapper opengl32.dll that turned the depth test off when a player model drew; the
+// later "chams" drew the hidden part of a player flat and bright. This is the second,
+// which is the first made visible, drawn so that hidden and seen cannot be confused:
+// before the normal draw, the player is drawn with the depth test reversed (only where a
+// wall won), untextured, as a faint orange tint marked in the stencil, and then once more
+// a little fatter where the mark is not — an orange outline round a ghost. What is in
+// plain sight is then drawn over it as usual. It shows exactly what those cheats showed —
+// the players the server sent, the potentially visible set, and no more — and does
+// nothing outside a recording: PARM_PLAYING_DEMO is the gate, not the cvar. It sits in
+// R_StudioDrawPoints because that is where every path draws: the Counter-Strike client
+// has a studio renderer of its own and calls back in here to emit the triangles.
+CVAR_DEFINE_AUTO( r_demo_xray, "0", 0, "draw players through walls while a recording plays" );
+static qboolean g_xrayPass;     // colour forced, lighting ignored
+static qboolean g_xrayInflate;  // vertices pushed out along their normals, for the rim
+static byte g_xrayAlpha;
+static void R_StudioDrawPointsPass( void );
+
+static void R_StudioDrawPoints( void )
+{
+	if( r_demo_xray.value != 0.0f && RI.currententity && RI.currententity->player && ENGINE_GET_PARM( PARM_PLAYING_DEMO ) != DEMO_INACTIVE )
+	{
+		// without a stencil buffer the ghost alone, a little stronger
+		qboolean outline = glState.stencilEnabled;
+
+		g_xrayPass = true;
+		pglDepthFunc( GL_GREATER );
+		pglDepthMask( GL_FALSE );
+		pglDisable( GL_TEXTURE_2D );
+		pglEnable( GL_BLEND );
+		pglBlendFunc( GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA );
+
+		if( outline )
+		{
+			pglEnable( GL_STENCIL_TEST );
+			pglStencilFunc( GL_ALWAYS, 1, 0xFFFFFFFF );
+			pglStencilOp( GL_KEEP, GL_KEEP, GL_REPLACE );
+		}
+		g_xrayAlpha = outline ? 56 : 128;
+		R_StudioDrawPointsPass();
+
+		if( outline )
+		{
+			pglStencilFunc( GL_NOTEQUAL, 1, 0xFFFFFFFF );
+			pglStencilOp( GL_KEEP, GL_KEEP, GL_KEEP );
+			g_xrayAlpha = 255;
+			g_xrayInflate = true;
+			R_StudioDrawPointsPass();
+			g_xrayInflate = false;
+			pglDisable( GL_STENCIL_TEST );
+		}
+
+		pglDisable( GL_BLEND );
+		pglEnable( GL_TEXTURE_2D );
+		pglDepthMask( GL_TRUE );
+		pglDepthFunc( GL_LEQUAL );
+		g_xrayPass = false;
+	}
+
+	R_StudioDrawPointsPass();
+}
