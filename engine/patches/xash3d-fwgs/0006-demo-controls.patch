 /*
 =================
+CL_DemoFrametimeScale
+
+how much faster than real time the frame runs: demo_speed while a GoldSrc demo plays
+=================
+*/
+float CL_DemoFrametimeScale( void )
+{
+	if( cls.demoplayback != DEMO_GOLDSRC || demo_pause.value )
+		return 1.0f;
+	return bound( 0.25f, demo_speed.value, 4.0f );
+}
+
+/*
+=================
+CL_HLDemoLength
+
+the recording's own length: the playback sections' times
+=================
+*/
+static float CL_HLDemoLength( void )
+{
+	float	length = 0.0f;
+	int	i;
+
+	for( i = 1; i < demo.directory.numentries; i++ )
+		length += demo.directory.entries[i].playback_time;
+	return length;
+}
+
+/*
+=================
+CL_DemoSeek_f
+
+demo_seek <seconds>: forward by running the frames in between without waiting, backward
+by starting the demo again and running forward to it
+=================
+*/
+void CL_DemoSeek_f( void )
+{
+	float	t;
+
+	if( Cmd_Argc() != 2 )
+	{
+		Con_Printf( S_USAGE "demo_seek <seconds>\n" );
+		return;
+	}
+
+	if( cls.demoplayback != DEMO_GOLDSRC )
+	{
+		Con_Printf( "demo_seek: no GoldSrc demo is playing\n" );
+		return;
+	}
+
+	t = Q_max( 0.0f, Q_atof( Cmd_Argv( 1 )));
+
+	if( demo.entryIndex > 0 && t >= demo.gs_clock )
+	{
+		demo.gs_clock = t;
+		demo.gs_seeking = true;
+		demo.gs_seek_frames = 0;
+		return;
+	}
+
+	// still loading: the playback section will start there
+	if( demo.entryIndex == 0 )
+	{
+		demo.gs_seek_pending = t;
+		return;
+	}
+
+	hldemo_seek_after_restart = t;
+	Cbuf_AddTextf( "playdemo \"%s\"\n", cls.demoname );
+}
+
+#if XASH_EMSCRIPTEN
+#include <emscripten.h>
+
+/*
+=================
+Demo_WebState
+
+what a page's controls need, as JSON, once per poll
+=================
+*/
+EMSCRIPTEN_KEEPALIVE const char *Demo_WebState( void )
+{
+	static char	state[512];
+
+	if( cls.demoplayback != DEMO_GOLDSRC )
+	{
+		Q_strncpy( state, "{\"playing\":0}", sizeof( state ));
+		return state;
+	}
+
+	Q_snprintf( state, sizeof( state ),
+		"{\"playing\":1,\"paused\":%i,\"seeking\":%i,\"time\":%.2f,\"at\":%.2f,\"length\":%.2f,\"speed\":%g,"
+		"\"section\":%i,\"sections\":%i,\"frame\":%i,\"protocol\":%i,\"spectator\":%i,\"state\":%i,\"map\":\"%s\"}",
+		demo_pause.value != 0.0f, demo.gs_seeking, demo.entryIndex > 0 ? demo.gs_clock : 0.0f,
+		demo.entryIndex > 0 ? demo.timestamp : 0.0f, CL_HLDemoLength(),
+		CL_DemoFrametimeScale(), demo.entryIndex, demo.directory.numentries, demo.framecount, demo.gs_protocol,
+		cls.spectator, cls.state, demo.header.mapname );
+	return state;
+}
+#endif
