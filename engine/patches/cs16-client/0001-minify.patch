client: -Oz for the side modules, as yohimik's "feat: minify" (4eaa61d) did

The published cs16-client@0.1.2 was built with this; the source it now builds from
(ololoken's main) does not carry it.

--- a/cl_dll/CMakeLists.txt
+++ b/cl_dll/CMakeLists.txt
@@ -60,8 +60,8 @@
 
 if(XASH_EMSCRIPTEN)
 	add_executable(${CLIENT_LIB} ${CS_CLIENT_SRC})
-	target_compile_options(${CLIENT_LIB} PRIVATE -fPIC)
-	target_link_options(${CLIENT_LIB} PRIVATE -sSIDE_MODULE=1)
+	target_compile_options(${CLIENT_LIB} PRIVATE -fPIC -Oz)
+	target_link_options(${CLIENT_LIB} PRIVATE -sSIDE_MODULE=1 -Oz)
 	set_target_properties(${CLIENT_LIB} PROPERTIES SUFFIX ".wasm")
 else()
 	add_library(${CLIENT_LIB} SHARED ${CS_CLIENT_SRC})
