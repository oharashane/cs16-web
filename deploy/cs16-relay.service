[Unit]
Description=cs16 relay — pages, client files, and the WebRTC bridge to the game servers
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Desktop/cs16-web/relay
# Rebuilt on every start, like darkoak: what runs is what the working tree says.
Environment=GOTOOLCHAIN=auto
Environment=HOME=%h
ExecStartPre=/usr/bin/go build -o %h/Desktop/cs16-web/relay/relay .
ExecStart=%h/Desktop/cs16-web/relay/relay
# Reaching this from outside the house needs a UDP tunnel for the game's data, because
# WebRTC is UDP and the Cloudflare tunnel carries only HTTP. playit provides one, and the
# one rule that matters is that pion advertises <public address>:<RELAY_ICE_PORT> — it can
# rewrite the address but not the port. So the tunnel's public port and its local port must
# be the same number, and RELAY_ICE_PORT must be that number too.
#
# The playit tunnel "csweb": roosevelt-etiology.tun.ply.gg:46089 -> 127.0.0.1:46089
Environment=RELAY_ICE_PORT=46089
Environment=RELAY_PUBLIC_IP=roosevelt-etiology.tun.ply.gg
# Where native Counter-Strike clients arrive. The playit tunnel "cs 1.6 udp (hlds)",
# roosevelt-refuses.tun.ply.gg:9767, must forward to THIS port rather than straight to the
# game server's 27015: everyone through a tunnel shares the agent's address, and ReHLDS
# reads a second connection from a known address as the first player reconnecting. The
# ingress gives each of them an address of its own. See steam.go.
Environment=RELAY_STEAM_PORT=27515
# RELAY_ADMIN_KEY, the password for / and /review, lives in a file of its own (mode 600,
# not in git) so it is never in a unit file, a shell history, or a chat.
EnvironmentFile=-%h/Desktop/cs16-web/.relay.env
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
