{
  "name": "cs16-web-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The browser client: Xash3D-FWGS 1.2.2 and cs16-client 0.1.2, vendored, over WebRTC to the relay.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "build:next": "vite build --base /next/ --outDir dist-next",
    "build:next:gl4es": "ENGINE_REF=gl4es vite build --base /next/ --outDir dist-next",
    "build:vendored": "python3 ../scripts/patch-wasm-heap.py node_modules/xash3d-fwgs/dist 1536 && ENGINE=vendored vite build",
    "bench": "node bench/boot.mjs && node bench/load.mjs && node bench/fps.mjs && node bench/pool.mjs"
  },
  "dependencies": {
    "cs16-client": "file:vendor/cs16-client-0.1.2.tgz",
    "cs16-client-built": "file:../engine/cs16-client",
    "jszip": "^3.10.2",
    "xash3d-fwgs": "file:vendor/xash3d-fwgs-1.2.2.tgz",
    "xash3d-fwgs-built": "file:../engine/xash3d-fwgs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
